<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Referencia obligatoria de la Factura Electronica de Compra.
             El esquema 4.4 exige InformacionReferencia en la FEC, pero no hay
             documento electronico previo al cual referirse: se declara el
             comprobante fisico del proveedor de regimen simplificado. -->
        <record id="param_fec_reference_document_code" model="ir.config_parameter">
            <field name="key">cr_electronic_invoice.fec_reference_document_code</field>
            <field name="value">14</field>
        </record>
        <record id="param_fec_reference_code" model="ir.config_parameter">
            <field name="key">cr_electronic_invoice.fec_reference_code</field>
            <field name="value">04</field>
        </record>
    </data>
</odoo>
