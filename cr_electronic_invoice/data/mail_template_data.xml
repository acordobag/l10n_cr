<?xml version="1.0"?>
<odoo>
    <record id="email_template_edi_expiration_notice" model="mail.template">
        <field name="name">Key Expiration Notice</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="email_from">{{ object.company_id.partner_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.email_formatted }}</field>
        <field name="subject">NOTIFICACION IMPORTANTE!!</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <h1>NOTIFICACION IMPORTANTE!!</h1>
                <p><t t-out="object.company_id.get_message_to_send()"/></p>
            </div>
        </field>
    </record>

    <record id="email_template_invoice_vendor" model="mail.template">
        <field name="name">Invoicing: Vendor Invoice email</field>
        <field name="email_from">{{ object.user_id.email_formatted or user.email_formatted }}</field>
        <field name="subject">{{ object.company_id.name }} Invoice (Ref {{ object.name or 'n/a' }})</field>
        <field name="partner_to">{{ object.partner_id.id }},{{ object.company_id.partner_id.id }}</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="auto_delete" eval="True"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
            <div>
                <p>
                    Dear <t t-out="object.partner_id.name or ''"/>
                    <t t-if="object.partner_id.parent_id">
                        (<i><t t-out="object.partner_id.parent_id.name"/></i>)
                    </t>,
                </p>
                <p>
                    <t t-out="object.company_id.name"/> has accepted in "Ministerio de Hacienda" your
                    <t t-if="object.name">
                        invoice <strong><t t-out="object.name"/></strong>
                    </t>
                    <t t-else="">invoice</t>
                    <t t-if="object.invoice_origin">
                        (with reference: <t t-out="object.invoice_origin"/>)
                    </t>
                    amounting in <strong><t t-out="format_amount(object.amount_total, object.currency_id)"/></strong>
                    from <t t-out="object.company_id.name"/>.
                </p>

                <br/>
                <strong>Electronic number: </strong><t t-out="object.number_electronic"/>
                <br/>
                <strong>Confirmation date: </strong><t t-out="object.date_issuance"/>
                <br/>
                <strong>Confirmation Message: </strong><t t-out="object.state_invoice_partner"/>
                <br/>
                <strong>"Hacienda" status: </strong><t t-out="object.state_tributacion"/>

                <br/><br/>
                <strong>Issuing company </strong>
                <br/>
                <strong>Name: </strong><t t-out="object.partner_id.name"/>
                <br/>
                <strong>Id: </strong><t t-out="object.partner_id.vat"/>

                <br/><br/>
                <strong>Receiving company </strong>
                <br/>
                <strong>Name: </strong><t t-out="object.company_id.name"/>
                <br/>
                <strong>Id: </strong><t t-out="object.company_id.vat"/>
                <br/><br/>
                Attached you'll find the XMLs with the message sent to "Hacienda" and its response for your backup
                <br/><br/>
                <p>Thank you,</p>
                <p style="color:#888888" t-if="object.user_id and object.user_id.signature">
                    <t t-out="object.user_id.signature"/>
                </p>
            </div>
        </field>
    </record>

    <record id="email_template_client_exoneration_expired" model="mail.template">
        <field name="name">Exoneration Expired</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="subject">{{ user.company_id.commercial_name or user.company_id.name }}: VAT exoneration expired</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="lang">{{ object.lang }}</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);">
                <p>Dear <t t-out="object.name"/>,</p>
                <p>
                    We realized that your VAT exoneration number
                    <t t-out="object.exoneration_number"/> is expired. Please update this information as soon as possible or we'll have to create new invoices including this tax.
                </p>
                <br/>
                <p>Thanks for all your help.</p>
                <br/>
                Best Regards,
                <br/><br/>
                <t t-out="user.name"/>
                <br/><br/><br/>
            </div>
        </field>
    </record>
</odoo>
