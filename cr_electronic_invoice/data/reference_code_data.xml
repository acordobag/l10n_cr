<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Referencia: Nota 9 v4.4 (Hacienda) -->

    <!-- 01 -->
    <record id="cr_electronic_invoice.ReferenceCode_1" model="reference.code">
        <field name="code">01</field>
        <field name="name">Anula Documento de Referencia</field>
        <field name="active">true</field>
    </record>

    <!-- 02  (en 4.4 = Corrige monto) -->
    <record id="cr_electronic_invoice.ReferenceCode_2" model="reference.code">
        <field name="code">02</field>
        <field name="name">Corrige monto</field>
        <field name="active">true</field>
    </record>

    <!-- 03 eliminado en 4.4: lo dejamos inactivo para no romper referencias antiguas -->
    <record id="cr_electronic_invoice.ReferenceCode_3" model="reference.code">
        <field name="code">03</field>
        <field name="name">[Inhabilitado en 4.4]</field>
        <field name="active">false</field>
    </record>

    <!-- 04 -->
    <record id="cr_electronic_invoice.ReferenceCode_4" model="reference.code">
        <field name="code">04</field>
        <field name="name">Referencia a otro documento</field>
        <field name="active">true</field>
    </record>

    <!-- 05 -->
    <record id="cr_electronic_invoice.ReferenceCode_5" model="reference.code">
        <field name="code">05</field>
        <field name="name">Sustituye comprobante provisional por contingencia</field>
        <field name="active">true</field>
    </record>

    <!-- 06 -->
    <record id="cr_electronic_invoice.ReferenceCode_6" model="reference.code">
        <field name="code">06</field>
        <field name="name">Devolución de mercancía</field>
        <field name="active">true</field>
    </record>

    <!-- 07 -->
    <record id="cr_electronic_invoice.ReferenceCode_7" model="reference.code">
        <field name="code">07</field>
        <field name="name">Sustituye comprobante electrónico</field>
        <field name="active">true</field>
    </record>

    <!-- 08 -->
    <record id="cr_electronic_invoice.ReferenceCode_8" model="reference.code">
        <field name="code">08</field>
        <field name="name">Factura Endosada</field>
        <field name="active">true</field>
    </record>

    <!-- 09 -->
    <record id="cr_electronic_invoice.ReferenceCode_9" model="reference.code">
        <field name="code">09</field>
        <field name="name">Nota de crédito financiera</field>
        <field name="active">true</field>
    </record>

    <!-- 10 -->
    <record id="cr_electronic_invoice.ReferenceCode_10" model="reference.code">
        <field name="code">10</field>
        <field name="name">Nota de débito financiera</field>
        <field name="active">true</field>
    </record>

    <!-- 11 -->
    <record id="cr_electronic_invoice.ReferenceCode_11" model="reference.code">
        <field name="code">11</field>
        <field name="name">Proveedor No Domiciliado</field>
        <field name="active">true</field>
    </record>

    <!-- 12 -->
    <record id="cr_electronic_invoice.ReferenceCode_12" model="reference.code">
        <field name="code">12</field>
        <field name="name">Crédito por exoneración posterior a la facturación</field>
        <field name="active">true</field>
    </record>

    <!--
      Codigos 13 a 16: Anexos y Estructuras v4.4 actualizados (comunicado del
      22-abr-2026, obligatorios desde el 1-nov-2026). Separan el ERROR MATERIAL
      -el documento salio mal- del hecho posterior -una devolucion real-, que
      siguen usando los codigos 01, 02 y 06.

      El 17 (Pago a comprobante electronico) NO se agrega: el esquema solo lo
      acepta en el Recibo Electronico de Pago, que este modulo todavia no
      emite. Ofrecerlo seria ofrecer un codigo que la validacion rechaza.
    -->

    <!-- 13 -->
    <record id="cr_electronic_invoice.ReferenceCode_13" model="reference.code">
        <field name="code">13</field>
        <field name="name">Anula documento de referencia por error material</field>
        <field name="active">true</field>
    </record>

    <!-- 14 -->
    <record id="cr_electronic_invoice.ReferenceCode_14" model="reference.code">
        <field name="code">14</field>
        <field name="name">Corrige monto por error material</field>
        <field name="active">true</field>
    </record>

    <!-- 15 -->
    <record id="cr_electronic_invoice.ReferenceCode_15" model="reference.code">
        <field name="code">15</field>
        <field name="name">Sustituye comprobante electrónico por error material</field>
        <field name="active">true</field>
    </record>

    <!-- 16 -->
    <record id="cr_electronic_invoice.ReferenceCode_16" model="reference.code">
        <field name="code">16</field>
        <field name="name">Sustituye comprobante electrónico rechazado</field>
        <field name="active">true</field>
    </record>

    <!-- 99 -->
    <record id="cr_electronic_invoice.ReferenceCode_99" model="reference.code">
        <field name="code">99</field>
        <field name="name">Otros</field>
        <field name="active">true</field>
    </record>

</odoo>
