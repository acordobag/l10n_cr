<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="after">
                <group invisible="move_type in ('in_invoice', 'in_refund', 'entry')">
                    <div class="alert alert-danger" role="alert" invisible="(state_tributacion) or (state in ('draft', 'cancel'))">
                        The document has not yet been issued, it will be sent automatically in 5 minutes, if you need to send it manually press 
                        <button class="btn btn-primary" name="generate_and_send_invoice" type="object" string="Send Document"/>
                    </div>
                </group>
                <group invisible="move_type == 'entry'">
                    <div class="alert alert-warning" role="alert" invisible="(state_tributacion != 'procesando') or (state in ('draft', 'cancel'))">
                        The document was issued successfully, however we still do not have the answer, it will be consulted in 10 minutes, if you wish to consult it manually press 
                        <button class="btn btn-primary" name="action_check_hacienda" type="object" string="Consult Document"/>
                    </div>
                </group>
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="after">

                <button name="action_send_mrs_to_hacienda" type="object" string="Send Receiver Message" invisible="(move_type not in ('in_invoice', 'in_refund', 'entry')) or (tipo_documento == 'FEC')"/>
                <button name="action_create_fec" type="object" string="Send FEC" invisible="(tipo_documento != 'FEC') or (state_tributacion not in (False, 'rechazado', 'error'))"/>
                <button name="create_partner_from_xml" class="oe_highlight" type="object" string="Create Provider" invisible="((move_type in ('entry', 'out_invoice', 'out_refund')) or (partner_id)) or (not xml_supplier_approval)"/>
            </xpath>

            <field name="narration" position="before">
                <field name="invoice_amount_text"/>
            </field>

            <field name="partner_id" position="after">
                <field name="economic_activities_ids" invisible="1" readonly="1" options="{&quot;active_test&quot;: [(&quot;type&quot;,&quot;in&quot;, (&quot;in_invoice&quot;, &quot;in_refund&quot;))]}"/>
                <field name="economic_activity_id" domain="[('id', 'in', economic_activities_ids),]" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True, &quot;active_test&quot;: [(&quot;type&quot;,&quot;in&quot;, (&quot;in_invoice&quot;, &quot;in_refund&quot;))]}" required="(move_type in ('out_invoice', 'out_refund')) or (tipo_documento == 'FEC')" invisible="(move_type not in ('out_invoice', 'out_refund')) and (tipo_documento != 'FEC')"/>
                <field name="number_electronic" readonly="1" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <field name="sequence" readonly="1" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </field>

            <field name="invoice_date" position="attributes">
                <attribute name="readonly"/>
            </field>

            <field name="invoice_date" position="after">
                <field name="date_issuance" readonly="1" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <field name="tipo_documento" readonly="state != 'draft'" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')" required="move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <field name="payment_methods_id" readonly="state != 'draft'" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')" required="move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>

                <field name="is_payment_method_99" invisible="1"/>
                <!-- Sólo visible y requerido si el método = 99 -->
                <field name="payment_method_otros" placeholder="Ej.: Transferencia internacional, pago en especie, etc." invisible="not is_payment_method_99" required="is_payment_method_99"/>
            </field>

            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='name']" position="after">
                <field name="categ_name" invisible="1" readonly="1"/>
                <field name="product_code" invisible="1" readonly="1"/>
                <field name="third_party_id" invisible="product_code != '04'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='discount']" position="after">
                <field name="fe_discount_code_id" context="{'create': 0}" required="discount &gt; 0"/>
                <field name="discount_note"/>
                <field name="tariff_head"/>
            </xpath>

            <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>

            <xpath expr="(//field[@name='amount_total'])[last()]" position="after">
                <field name="amount_tax_electronic_invoice" invisible="move_type in ('out_invoice', 'out_refund')"/>
                <field name="amount_total_electronic_invoice" invisible="move_type in ('out_invoice', 'out_refund')"/>
            </xpath>

            <xpath expr="//page[2]" position="after">
                <page name="fe_invoice_data" string="Electronic Information" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <group id="fe_tab_group" col="2">
                        <group string="Electronic Acceptance" name="fe_in_info_group" colspan="2" col="5" invisible="(tipo_documento == 'FEC') or (move_type in ('out_invoice', 'out_refund'))">
                            <field name="fname_xml_supplier_approval" invisible="1" colspan="5"/>
                            <field name="xml_supplier_approval" filename="fname_xml_supplier_approval" colspan="4" invisible="(tipo_documento == 'FEC') or (move_type in ('out_invoice', 'out_refund'))"/>
                            <button name="load_xml_data" type="object" string="Cargar datos del XML" colspan="1" invisible="(((not xml_supplier_approval) or (move_type in ('out_invoice', 'out_refund'))) or (tipo_documento == 'FEC')) or (state != 'draft')"/>
                            <field name="state_invoice_partner" colspan="5" invisible="(move_type in ('out_invoice', 'out_refund')) or (tipo_documento == 'FEC')"/>
                        </group>
                        <group name="eref_info_group" colspan="2">
                            <group string="Electronic Document Reference" name="eref_info_group1" colspan="2">
                                <field name="reference_code_id" readonly="state != 'draft'"/>
                                <field name="reference_document_id" readonly="state != 'draft'"/>
                                <field name="invoice_id" domain="[('number_electronic', '!=', False)]" readonly="state != 'draft'"/>
                            </group>
                            <group string="Electronic Receipts" name="eref_info_group2" colspan="2">
                                <field name="fname_xml_comprobante" invisible="1" readonly="1"/>
                                <field name="xml_comprobante" filename="fname_xml_comprobante"/>
                                <field name="fname_xml_respuesta_tributacion" invisible="1" readonly="1"/>
                                <field name="xml_respuesta_tributacion" filename="fname_xml_respuesta_tributacion"/>
                                <field name="state_tributacion" readonly="1"/>
                                <field name="electronic_invoice_return_message" readonly="1"/>
                            </group>
                        </group>

                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_inherit" model="ir.ui.view">
        <field name="name">account.invoice.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-danger">
                    state_tributacion == 'rechazado'
                </attribute>
            </list>
            <field name="state" position="before">
                <field name="tipo_documento" string="Doc Elect." optional="show"/>
                <field name="sequence" string="Consecutive" optional="show"/>
                <field name="move_type" invisible="1" readonly="1" optional="show"/>
                <field name="state_tributacion" string="State FE" optional="show"/>
            </field>
            <field name="company_id" position="after">
                <field name="amount_untaxed_signed" string="Total sin impuestos" optional="hide"/>
                <field name="amount_total_signed" sum="Total" string="Total" optional="hide"/>
                <field name="comp_amount_untaxed" sum="Total" string="Total sin impuestos" optional="show"/>
                <field name="comp_amount_total" sum="Total" string="Total" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="name" string="Invoice" filter_domain="['|', '|', '|', '|', ('name', 'ilike', self), ('invoice_origin', 'ilike', self), ('ref', 'ilike', self), ('payment_reference', 'ilike', self), ('partner_id', 'child_of', self)]"/>
        </field>
    </record>
</odoo>
