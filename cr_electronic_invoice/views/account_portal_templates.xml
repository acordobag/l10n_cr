<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_invoices_inherit_fe" inherit_id="account.portal_my_invoices">
        <xpath expr="//th[@name='amount_due']" position="before">
            <th name="electronic_document" class="text-end">Doc. Elect.</th>
            <th name="tax_status" class="text-end">Estado Tributacion</th>
        </xpath>
        <xpath expr="//td[@name='invoice_amount']" position="before">
            <td name="electronic_document" class="text-end">
                <span t-field="invoice.tipo_documento"/>
            </td>
            <td name="tax_status" class="text-end">
                <span t-field="invoice.state_tributacion"/>
            </td>
        </xpath>
    </template>

    <template id="portal_invoice_page_inherit_fe" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="after">
            <div t-if="invoice.number_electronic" class="d-flex flex-lg-column flex-xl-row flex-wrap gap-2">
                <a class="btn btn-light flex-grow-1"
                   t-att-href="invoice.get_xml_document(invoice.id)"
                   id="get_xml"
                   title="Get XML"
                   role="button">
                    <i class="fa fa-file-code-o"/> Get XMLs
                </a>
            </div>
        </xpath>
    </template>
</odoo>
