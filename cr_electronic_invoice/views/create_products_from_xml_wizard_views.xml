<odoo>
  <record id="view_create_products_from_xml_wizard_form" model="ir.ui.view">
    <field name="name">create.products.from.xml.wizard.form</field>
    <field name="model">create.products.from.xml.wizard</field>
    <field name="arch" type="xml">
      <form string="Create products from XML">
        <group>
          <field name="move_id" invisible="1"/>
        </group>
        <field name="line_ids" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
          <tree editable="bottom">
            <field name="name" attrs="{'required': [('to_create','=',True)]}"/>
            <field name="code"/>
            <field name="cabys"/>
            <field name="uom_id"/>
            <field name="qty" readonly="1"/>
            <field name="price_unit" readonly="1"/>
            <field name="product_candidate_id" options="{'no_create': True}"/>
            <field name="to_create"/>
          </tree>
        </field>
        <footer>
          <button string="Create and link" type="object" name="action_create_and_link" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_create_products_from_xml" model="ir.actions.act_window">
    <field name="name">Create products from XML</field>
    <field name="res_model">create.products.from.xml.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="view_create_products_from_xml_wizard_form"/>
  </record>
</odoo>
