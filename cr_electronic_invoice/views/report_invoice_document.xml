<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_fecr" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="after">
            <div id="fecr_electronic_data" class="row mt-3 mb-3" t-if="o.number_electronic or o.sequence or o.tipo_documento">
                <div class="col-auto col-3 mw-100 mb-2" t-if="o.number_electronic" name="number_electronic">
                    <strong>Electronic Number:</strong>
                    <p class="m-0" t-field="o.number_electronic"/>
                </div>
                <div class="col-auto col-3 mw-100 mb-2" t-if="o.sequence" name="sequence">
                    <strong>Electronic Consecutive:</strong>
                    <p class="m-0" t-field="o.sequence"/>
                </div>
                <div class="col-auto col-3 mw-100 mb-2" t-if="o.tipo_documento" name="tipo_documento">
                    <strong>Document Type:</strong>
                    <p class="m-0" t-field="o.tipo_documento"/>
                </div>
                <div class="col-auto col-3 mw-100 mb-2" t-if="o.payment_methods_id" name="payment_method">
                    <strong>Payment Method:</strong>
                    <p class="m-0" t-field="o.payment_methods_id.name"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//span[@id='line_tax_ids']" position="after">
            <br t-if="line.product_id and line.product_id.cabys_code"/>
            <span class="text-muted" t-if="line.product_id and line.product_id.cabys_code" t-field="line.product_id.cabys_code"/>
        </xpath>

        <xpath expr="//div[@id='qrcode']" position="after">
            <p t-if="o.move_type in ('out_invoice', 'out_refund')">
                <span>AUTORIZADO MEDIANTE RESOLUCION MH-DGT-RES-0027-2024 DEL 13-11-2024<br/>Factura Electronica Version 4.4</span>
            </p>
            <div t-if="o.qr_image" class="mt-2 mb-2">
                <span t-field="o.qr_image" t-options='{"widget": "image"}'/>
            </div>
            <div id="fecr_exoneration" t-if="o.partner_id.has_exoneration">
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Exoneration Number</th>
                            <th>Authorization Type</th>
                            <th>Exoneration Issuer</th>
                            <th>Issue Date</th>
                            <th>Expiration Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="o.partner_id.exoneration_number"/></td>
                            <td><span t-field="o.partner_id.type_exoneration"/></td>
                            <td><span t-field="o.partner_id.institution_name"/></td>
                            <td><span t-field="o.partner_id.date_issue"/></td>
                            <td><span t-field="o.partner_id.date_expiration"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
