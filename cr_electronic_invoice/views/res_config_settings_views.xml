<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fecr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Costa Rica Electronic Invoice" name="fecr_xml_load">
                    <setting string="XML Import Defaults" help="Default values used when importing supplier electronic invoices.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="expense_product_id" class="col-lg-4 o_light_label"/>
                                <field name="expense_product_id"/>
                            </div>
                            <div class="row">
                                <label for="expense_account_id" class="col-lg-4 o_light_label"/>
                                <field name="expense_account_id" required="1"/>
                            </div>
                            <div class="row" invisible="not group_analytic_accounting">
                                <label for="expense_analytic_account_id" class="col-lg-4 o_light_label"/>
                                <field name="expense_analytic_account_id"/>
                            </div>
                            <div class="row">
                                <label for="load_lines" class="col-lg-4 o_light_label"/>
                                <field name="load_lines"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
