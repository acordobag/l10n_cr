<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cr_iva_report_d150_wizard_form" model="ir.ui.view">
        <field name="name">cr.iva.report.d150.wizard.form</field>
        <field name="model">cr.iva.report.d150.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de conciliación IVA (D-150 / TRIBU-CR)">
                <sheet>
                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('computed','=', False)]}">
                        Este reporte es un apoyo para conciliar contra el borrador que TRIBU-CR
                        prellena con los comprobantes electrónicos aceptados. No presenta la
                        declaración por usted; revise los montos y las advertencias antes de
                        confirmar el Formulario 150.
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_compute" type="object" string="Calcular"
                                class="btn-primary"/>
                    </footer>

                    <notebook attrs="{'invisible': [('computed', '=', False)]}">
                        <page string="Resumen">
                            <group>
                                <group string="Ventas (débito fiscal)">
                                    <field name="ventas_gravadas_13" widget="monetary"/>
                                    <field name="ventas_gravadas_otras" widget="monetary"/>
                                    <field name="ventas_no_sujetas" widget="monetary"/>
                                    <field name="ventas_exentas" widget="monetary"/>
                                    <field name="ventas_exoneradas" widget="monetary"/>
                                    <field name="debito_fiscal" widget="monetary"/>
                                </group>
                                <group string="Compras (crédito fiscal)">
                                    <field name="compras_credito_13" widget="monetary"/>
                                    <field name="compras_credito_otras" widget="monetary"/>
                                    <field name="compras_no_deducible" widget="monetary"/>
                                    <field name="credito_fiscal" widget="monetary"/>
                                </group>
                            </group>
                            <group>
                                <field name="iva_a_pagar" widget="monetary"
                                       style="font-weight: bold; font-size: 1.2em;"/>
                                <field name="warning_count"/>
                            </group>
                        </page>
                        <page string="Advertencias" attrs="{'invisible': [('warning_count', '=', 0)]}">
                            <field name="warning_ids">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="move_id"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Detalle">
                            <field name="line_ids">
                                <tree create="false" delete="false" default_order="invoice_date">
                                    <field name="invoice_date"/>
                                    <field name="move_id"/>
                                    <field name="tipo_documento"/>
                                    <field name="partner_id"/>
                                    <field name="product_id"/>
                                    <field name="bucket"/>
                                    <field name="base_amount" sum="Base"/>
                                    <field name="tax_amount" sum="IVA"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cr_iva_report_d150_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de conciliación IVA (D-150)</field>
        <field name="res_model">cr.iva.report.d150.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cr_iva_report_d150"
              name="Conciliación IVA CR (D-150)"
              parent="account.menu_finance"
              action="action_cr_iva_report_d150_wizard"
              sequence="95"/>

</odoo>
