<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hacienda.info.query</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Electronic Invoicing Costa Rica" name="hacienda_info_query_settings">
                    <setting string="Yo Contribuyo">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="url_base_yo_contribuyo" class="col-lg-4 o_light_label"/>
                                <field name="url_base_yo_contribuyo"/>
                            </div>
                            <div class="row">
                                <label for="usuario_yo_contribuyo" class="col-lg-4 o_light_label"/>
                                <field name="usuario_yo_contribuyo"/>
                            </div>
                            <div class="row">
                                <label for="token_yo_contribuyo" class="col-lg-4 o_light_label"/>
                                <field name="token_yo_contribuyo"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Hacienda API">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="url_base" class="col-lg-4 o_light_label"/>
                                <field name="url_base"/>
                            </div>
                            <div class="row">
                                <label for="ultima_respuesta" class="col-lg-4 o_light_label"/>
                                <field name="ultima_respuesta" readonly="1"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
