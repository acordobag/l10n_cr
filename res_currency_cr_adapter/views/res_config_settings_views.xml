<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_crc_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.crc.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                <setting id="cr_exchange_source" string="Origen del tipo de cambio">
                    <field name="exchange_source"/>
                    <div class="content-group" invisible="exchange_source != 'bccr'">
                        <div class="row mt8">
                            <label for="bccr_username" class="col-lg-4 o_light_label" string="Usuario BCCR"/>
                            <field name="bccr_username"/>
                        </div>
                        <div class="row mt8">
                            <label for="bccr_email" class="col-lg-4 o_light_label" string="Email BCCR"/>
                            <field name="bccr_email"/>
                        </div>
                        <div class="row mt8">
                            <label for="bccr_token" class="col-lg-4 o_light_label" string="Token BCCR"/>
                            <field name="bccr_token" password="True"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
